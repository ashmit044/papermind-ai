# PaperMind AI Configuration Settings

# Supported LLM backends: "offline", "ollama", or "openai"
PAPERMIND_LLM_PROVIDER=offline

# Optional API key (required only for the OpenAI backend)
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Model Configuration
PAPERMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2
PAPERMIND_CHUNK_SIZE=500
PAPERMIND_CHUNK_OVERLAP=50

# Minimum cosine similarity for a passage to be used as evidence (-1 to 1)
PAPERMIND_MIN_SIMILARITY=0.20

# Logging & Environment
PAPERMIND_LOG_LEVEL=INFO
PAPERMIND_CACHE_DIR=./cache
