# PaperMind AI Configuration Settings

# LLM Backend: "offline", "ollama", "huggingface", or "openai"
PAPERMIND_LLM_PROVIDER=offline

# Optional API Keys (Only needed if provider is openai or huggingface)
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_huggingface_token_here

# Embedding Model Configuration
PAPERMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2
PAPERMIND_CHUNK_SIZE=500
PAPERMIND_CHUNK_OVERLAP=50

# Logging & Environment
PAPERMIND_LOG_LEVEL=INFO
PAPERMIND_CACHE_DIR=./cache
